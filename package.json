{
  "name": "bivol-boxing-3d",
  "version": "1.0.0",
  "description": "3D Boxing Game featuring Dmitry Bivol - Championship Edition",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux",
    "build-win": "electron-builder --win",
    "build-all": "electron-builder --win --linux"
  },
  "build": {
    "appId": "com.bivol.boxing3d",
    "productName": "Bivol Boxing 3D",
    "files": [
      "index.html",
      "main.js",
      "three.min.js"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  },
  "author": "Bivol Boxing",
  "license": "MIT",
  "devDependencies": {
    "electron": "^40.1.0",
    "electron-builder": "^26.7.0"
  },
  "dependencies": {
    "three": "^0.128.0"
  }
}
